#!/bin/bash

GF_SCRIPTS_DIR="/pi_dev_scripts/builtin"
GF_SKETCH_FILE="/home/pi_dev/workdir/GF_SKETCH.md"
GF_TODO_FILE="/home/pi_dev/workdir/GF_TODO.md"

GF_PI_DEFAULT_MODEL_FILE="/home/pi_dev/.default_model"
GF_PI_MODELS=(
	glacierflow-coder-feather
	glacierflow-coder-light
	glacierflow-coder-default
	glacierflow-coder-heavy
	glacierflow-coder-thinking-feather
	glacierflow-coder-thinking-light
	glacierflow-coder-thinking-default
	glacierflow-coder-thinking-heavy
)
GF_PI_DEFAULT_MODEL="glacierflow-coder-thinking-default"

cd /home/pi_dev/workdir

if [ -f "$GF_PI_DEFAULT_MODEL_FILE" ]; then
	savedModel=$(tr -d '[:space:]' < "$GF_PI_DEFAULT_MODEL_FILE")
	for m in "${GF_PI_MODELS[@]}"; do
		if [ "$m" = "$savedModel" ]; then
			GF_PI_DEFAULT_MODEL=$savedModel
			break
		fi
	done
fi

run_bash() {
	bash
}

run_pi() {
	pi --model "$(get_default_model)"
}

run_pi_select() {
	pi --model "$(get_default_model)" -r
}

run_pi_continue() {
	pi --model "$(get_default_model)" -c
}

run_pi_ephemeral() {
	pi --model "$(get_default_model)" --no-session
}

get_default_model() {
	echo "$GF_PI_DEFAULT_MODEL"
}

set_default_model() {
	if [ -z "$1" ]; then
		echo "ERROR: empty model name"
		return 1
	fi
	local known
	for known in "${GF_PI_MODELS[@]}"; do
		if [ "$known" = "$1" ]; then
			break
		fi
	done
	if [ "$known" != "$1" ]; then
		echo "ERROR: unknown model: $1"
		return 1
	fi
	GF_PI_DEFAULT_MODEL=$1
	echo "$GF_PI_DEFAULT_MODEL" > "$GF_PI_DEFAULT_MODEL_FILE"
}

automation_menu() {
	while true; do
		clear
		echo ""
		echo "You're in a pi.dev box automation menu!"
		echo ""
		echo "Default model: $(get_default_model)"
		echo ""
		echo "Select action:"
		echo ""
		echo "[S] Prepare/update SKETCH - file where you define what would you like to have coded"
		if [ -f $GF_SKETCH_FILE ]; then
			echo "[P] Convert SKETCH to TODO file"
			echo "[Q] Convert SKETCH to TODO file with interactive shell"
		fi
		echo "[T] Prepare/update TODO   - file where you define exact steps for automatic coder"
		if [ -f $GF_TODO_FILE ]; then
			echo "[R] Run automatic development based on TODO file"
			echo "[C] Run automatic development based on TODO file with internal critic"
		fi
		echo ""
		echo "[M] Change default model"
		echo "[X] back to main menu"
		echo ""
		read -p "Selected action: " actionToRun
		case "$actionToRun" in
		x | X)
			break
			;;
		s | S)
			clear
			vim $GF_SKETCH_FILE
			;;
		p | P)
			clear
			run_pi_noninteractive_with_script "auto_planner"
			;;
		q | Q)
			clear
			run_pi_interactive_with_script "auto_planner"
			;;
		t | T)
			clear
			vim $GF_TODO_FILE
			;;
		r | R)
			clear
			local roundNumber=1
			while [[ -f "$GF_TODO_FILE" ]]; do
				echo "Running iteration #$roundNumber"
				run_pi_noninteractive_with_script "auto_programmer"
				roundNumber=$((roundNumber + 1))
			done
			;;
		c | C)
			clear
			local roundNumber=1
			while [[ -f "$GF_TODO_FILE" ]]; do
				echo "Running iteration #$roundNumber"
				run_pi_noninteractive_with_script "auto_programmer"
				if [ -f $GF_TODO_FILE ]; then
					run_pi_noninteractive_with_script "auto_critic"
				fi
				roundNumber=$((roundNumber + 1))
			done
			;;
		m | M)
			clear
			default_model_selection
			;;
		*)
			echo ""
			;;
		esac
	done
}

run_pi_noninteractive_with_script() {
	local scriptName=$1
	local fullScriptPath="$GF_SCRIPTS_DIR/$scriptName.txt"
	if [ -f "$fullScriptPath" ]; then
		local scriptContent=$(cat "$fullScriptPath")
		echo "Running script $scriptName..."
		pi --model "$(get_default_model)" -p "$scriptContent"
	else
		echo "ERROR: $fullScriptPath NOT FOUND"
		sleep 5
	fi
}

run_pi_interactive_with_script() {
	local scriptName=$1
	local fullScriptPath="$GF_SCRIPTS_DIR/$scriptName.txt"
	if [ -f "$fullScriptPath" ]; then
		local scriptContent=$(cat "$fullScriptPath")
		echo "Starting script..."
		pi --model "$(get_default_model)" "$scriptContent"
	else
		echo "ERROR: $fullScriptPath NOT FOUND"
		sleep 5
	fi
}

default_model_selection() {
	clear
	echo "Select default model: "
	echo ""
	local i=1
	local printedThinking=0
	for model in "${GF_PI_MODELS[@]}"; do
		if [[ "$model" == *"-thinking-"* ]] && [ "$printedThinking" -eq 0 ]; then
			echo ""
			printedThinking=1
		fi
		local marker=" "
		if [ "$model" = "$(get_default_model)" ]; then
			marker="*"
		fi
		echo "[$i]$marker $model"
		i=$((i + 1))
	done
	echo ""
	read -p "Selected model: " modelToSet
	if [[ "$modelToSet" =~ ^[0-9]+$ ]] && [ "$modelToSet" -ge 1 ] && [ "$modelToSet" -le "${#GF_PI_MODELS[@]}" ]; then
		set_default_model "${GF_PI_MODELS[$((modelToSet - 1))]}"
	else
		echo "$modelToSet is not an option, aborting..."
		sleep 2
	fi
}

kickoff_menu() {
	while true; do
		clear
		echo ""
		echo "You're in a pi.dev box kick-off menu!"
		echo ""
		echo "Default model: $(get_default_model)"
		echo ""
		echo "Select action:"
		echo ""
		echo "[C] Start Code Review"
		echo "[B] Find bugs"
		echo "[I] Propose Improvements"
		echo "[R] Update Readme"
		echo ""
		echo "[M] Change default model"
		echo "[X] back to main menu"
		echo ""
		read -p "Selected action: " actionToRun
		case "$actionToRun" in
		x | X)
			break
			;;
		b | B)
			clear
			run_pi_interactive_with_script "init_bugs"
			;;
		c | C)
			clear
			run_pi_interactive_with_script "init_code_review"
			;;
		i | I)
			clear
			run_pi_interactive_with_script "init_improvements"
			;;
		r | R)
			clear
			run_pi_interactive_with_script "init_readme"
			;;
		m | M)
			clear
			default_model_selection
			;;
		*)
			echo ""
			;;
		esac
	done
}

pi_update() {
	export PATH="$HOME/.local/bin:$PATH"
	if command -v pi >/dev/null; then
		echo "Checking for updates..."
		pi update
		pi update --extensions
	else
		echo "installing pi..."
		curl -fsSL https://pi.dev/install.sh | sh
		# skipping extensions installation
		# (no enforcement, let user install extensions, they survive image rebuild)
	fi
}

run_main() {
	local actionToRun
	while true; do
		clear
		echo ""
		echo "You're in a pi.dev box!"
		echo ""
		echo "Default model: $(get_default_model)"
		echo ""
		echo "Select action:"
		echo "[N] New session"
		echo "[C] Continue last session"
		echo "[S] Select session"
		echo "[E] Ephemeral (no session)"
		# TODO pi --mode rpc could be exposed but that would be not too pragmatic
		# better run `docker exec -it "glacierflow-pi-dev" pi $@` from the outside?
		# or additional binary bridge like REST <-> bridge <-> pi
		# and build webui around it?
		echo ""
		echo "[A] Automation"
		echo "[K] New session with builtin conversation-starter"
		echo "[B] Bash"
		echo ""
		echo "[M] Change default model"
		echo "[X] exit / detach from container"
		echo ""
		read -p "Selected action: " actionToRun
		case "$actionToRun" in
		x | X)
			echo "👋 Bye!"
			exit 0
			break
			;;
		b | B)
			clear
			run_bash
			;;
		n | N)
			clear
			run_pi
			;;
		e | E)
			clear
			run_pi_ephemeral
			;;
		s | S)
			clear
			run_pi_select
			;;
		c | C)
			clear
			run_pi_continue
			;;
		a | A)
			clear
			automation_menu
			;;
		k | K)
			clear
			kickoff_menu
			;;
		m | M)
			clear
			default_model_selection
			;;
		*)
			echo ""
			;;
		esac
	done
}

pi_update

run_main

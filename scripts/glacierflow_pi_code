#!/bin/bash
rootScriptDirectory=$(pwd)
source "$rootScriptDirectory/gf_common.sh"

# ── Script-specific constants ─────────────────────────────────────────────────

GF_PI_DEV_SERVICE="glacierflow-pi-dev"
GF_CONTAINER_START_TIMEOUT=120

# ── pi.dev helpers ────────────────────────────────────────────────────────────

inference_preset_change() {
	local selectedPreset=""
	while [ -z "$selectedPreset" ]; do
		tty_clear
		"$(dirname "$0")/glacierflow_inference_select_preset"
		echo ""
		read -p "Preset to load: " selectedPreset
	done
	"$(dirname "$0")/glacierflow_inference_select_preset" "$selectedPreset"
	sleep 1
}

is_pi_dev_running() {
	if [ "$(docker ps --filter status=running | grep "$GF_PI_DEV_SERVICE" | wc -l)" -lt 1 ]; then
		echo "0"
	else
		echo "1"
	fi
}

pi_dev_attach() {
	docker exec -it "$GF_PI_DEV_SERVICE" bash /pi_dev/start
}

pi_dev_attach_tmux() {
	docker exec -it "$GF_PI_DEV_SERVICE" bash /pi_dev/start_tmux
}

pi_dev_reset() {
	cd "$rootScriptDirectory"
	cd "../docker/pi_dev/"
	if [ -f "../../.env" ]; then
		set -a
		source "../../.env"
		set +a
	fi
	docker compose -p "$GF_STACK_NAME" build --no-cache
	cd "$rootScriptDirectory"
}

pi_dev_start() {
	echo "Starting pi.dev..."
	cd "$rootScriptDirectory"
	cd "../docker/pi_dev/"
	if [ -f "../../.env" ]; then
		set -a
		source "../../.env"
		set +a
	fi
	docker compose -p "$GF_STACK_NAME" up -d
	local isRunning="0"
	local elapsed=0
	while [[ $isRunning == "0" ]]; do
		if [ "$elapsed" -ge "$GF_CONTAINER_START_TIMEOUT" ]; then
			echo "Error: container failed to start within ${GF_CONTAINER_START_TIMEOUT}s. Aborting."
			cd "$rootScriptDirectory"
			return 1
		fi
		echo "waiting for container... (${elapsed}/${GF_CONTAINER_START_TIMEOUT}s)"
		isRunning=$(is_pi_dev_running)
		sleep 1
		elapsed=$((elapsed + 1))
	done
	cd "$rootScriptDirectory"
}

pi_dev_stop() {
	echo "Stopping pi.dev..."
	cd "$rootScriptDirectory"
	cd "../docker/pi_dev/"
	docker stop "$GF_PI_DEV_SERVICE"
	cd "$rootScriptDirectory"
}

# ── Main ──────────────────────────────────────────────────────────────────────

run_main() {
	local actionToRun
	while true; do
		local currentPresetName=""
		if [ -f "$GF_INFERENCE_PRESET_NAME" ]; then
			currentPresetName=$(cat "$GF_INFERENCE_PRESET_NAME")
		fi
		tty_clear
		echo ""
		echo "pi.dev in a box!"
		if [ ! -z "$currentPresetName" ]; then
			echo ""
			echo "Inference preset: $currentPresetName"
		fi
		echo ""
		echo "Select action:"
		if [ "$(is_pi_dev_running)" -eq 1 ]; then
			echo "[A] attach to pi.dev"
			echo "[H] attach to pi.dev (httpd/tmux session)"
			echo "[D] stop pi.dev container"
		else
			echo "[U] start pi.dev container"
		fi
		echo "[R] update / hard reset container"
		echo ""
		echo "[P] change inference preset"
		echo "[X] exit"
		echo ""
		read -p "Selected action: " actionToRun
		case "$actionToRun" in
		x | X)
			echo "👋 Bye!"
			exit 0
			break
			;;
		u | U)
			tty_clear
			pi_dev_start
			;;
		d | D)
			tty_clear
			pi_dev_stop
			;;
		a | A)
			tty_clear
			pi_dev_attach
			;;
		h | H)
			tty_clear
			pi_dev_attach_tmux
			;;
		r | R)
			tty_clear
			pi_dev_stop
			pi_dev_reset
			;;
		p | P)
			tty_clear
			inference_preset_change
			;;
		*)
			echo ""
			;;
		esac
	done
}

tty_clear
run_main

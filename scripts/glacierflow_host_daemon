#!/bin/bash

rootScriptDirectory=$(pwd)
source "$rootScriptDirectory/gf_common.sh"
# ── Script-specific constants ─────────────────────────────────────────────────

GF_DAEMON_MODE_FREQUENCY=10
GF_STATS_DIR="./../data/stats/"
GF_LOG_STATS=0        #override in .env
GF_HERMES_AUTOSTART=0 #override in .env
GF_VSCODE_AUTOSTART=0 #override in .env

lastPerformanceLogLine=""

if [ -z "$1" ]; then
	isDaemon=0
else
	isDaemon=1
fi

# ── Daemon helpers ────────────────────────────────────────────────────────────

log_inference_statistics() {
	if [[ $GF_LOG_STATS -eq 1 ]]; then
		local workingDir=$(pwd)
		cd $rootScriptDirectory
		currentStatus=$(cat "$GF_INFERENCE_SERVICE_UP_STATUS")
		if [[ $currentStatus == 'RUNNING' ]]; then
			if [ ! -d "$GF_STATS_DIR" ]; then
				mkdir -p "$GF_STATS_DIR"
			fi
			local currentLogLine=$(./glacierflow_inference_log_parse_current "no_header")
			if [ ! -z "$currentLogLine" ]; then
				local expectedLogLinePrefix=$(date "+%Y-%m-%d")
				if [[ $currentLogLine == "$expectedLogLinePrefix"* ]]; then
					local newLogFound=1
					local currentName=$(cat "$GF_INFERENCE_PRESET_NAME")
					currentName=$(echo $currentName"_")
					local currentHash=$(cat "$GF_INFERENCE_SERVICE_UP_HASH")
					local logPrefix=$(date "+%y%m%d_")
					local logFileName=$(echo "$GF_STATS_DIR$logPrefix$currentName$currentHash.log")
					if [[ $currentLogLine == $lastPerformanceLogLine ]]; then
						newLogFound=0
					elif [ -f "$logFileName" ]; then
						if [[ $currentLogLine == $(tail -1 "$logFileName") ]]; then
							newLogFound=0
						fi
					fi
					if [[ $newLogFound -eq 1 ]]; then
						echo "$currentLogLine" >>"$logFileName"
						lastPerformanceLogLine="$currentLogLine"
					fi
				fi
			fi
		fi
		cd $workingDir
	fi
}

log_inference_status() {
	local workingDir=$(pwd)
	local currentStatus="UNKNOWN"
	cd $rootScriptDirectory
	if [ -f "$GF_INFERENCE_SERVICE_UP_STATUS" ]; then
		currentStatus=$(cat "$GF_INFERENCE_SERVICE_UP_STATUS")
	fi

	if [[ "$currentStatus" != "$1" ]]; then
		echo "$1" >"$GF_INFERENCE_SERVICE_UP_STATUS"
		echo "Inference status change to: $1"
	fi
	cd $workingDir
}

run_embedding_server() {
	cd "$rootScriptDirectory"
	if [ -f "../docker/llama_embeddings/compose.override.yml" ]; then
		echo "Starting Embedding Server..."
		cd "../docker/llama_embeddings/"
		if [ -f "../../.env" ]; then
			set -a
			source "../../.env"
			set +a
		fi
		docker compose -p "$GF_STACK_NAME" up -d
		cd "$rootScriptDirectory"
	fi
}

run_proxy() {
	cd "$rootScriptDirectory"
	echo "Starting FIFO Proxy Server..."
	cd "../docker/fifo_proxy/"
	if [ -f "../../.env" ]; then
		set -a
		source "../../.env"
		set +a
	fi
	docker compose -p "$GF_STACK_NAME" up -d
	cd "$rootScriptDirectory"
}

run_hermes() {
	if [[ $GF_HERMES_AUTOSTART -eq 1 ]]; then
		echo "Starting hermes..."
		cd "$rootScriptDirectory"
		mkdir -p "../data/hermes"
		cd "../docker/hermes/"
		if [ -f "../../.env" ]; then
			set -a
			source "../../.env"
			set +a
		fi
		docker compose -p "$GF_STACK_NAME" up -d
		cd "$rootScriptDirectory"
	fi
}

run_web_ui() {
	echo "Starting WEB UI..."
	cd "$rootScriptDirectory"
	cd "../docker/webui/"
	if [ -f "../../.env" ]; then
		set -a
		source "../../.env"
		set +a
	fi
	docker compose -p "$GF_STACK_NAME" up -d
	cd "$rootScriptDirectory"
}

run_pi_dev() {
	echo "Starting pi.dev..."
	cd "$rootScriptDirectory"
	cd "../docker/pi_dev/"
	if [ -f "../../.env" ]; then
		set -a
		source "../../.env"
		set +a
	fi
	docker compose -p "$GF_STACK_NAME" up -d
	cd "$rootScriptDirectory"
}

run_caddy() {
	echo "Starting caddy..."
	cd "$rootScriptDirectory"

	if [ ! -f "../data/ssl_certs/cert.pem" ]; then
		openssl req -x509 -newkey rsa:4096 -keyout "../data/ssl_certs/key.pem" -out "../data/ssl_certs/cert.pem" -subj "/C=CN/ST=GD/L=SZ/O=Acme, Inc./CN=Acme Root CA" -days 3650 -nodes
	fi

	cd "../docker/caddy/"
	if [ -f "../../.env" ]; then
		set -a
		source "../../.env"
		set +a
	fi
	docker compose -p "$GF_STACK_NAME" up -d
	cd "$rootScriptDirectory"
}

run_vscode() {
	if [[ $GF_VSCODE_AUTOSTART -eq 1 ]]; then
		echo "Starting vscode..."
		cd "$rootScriptDirectory"
		cd "../docker/vscode/"
		if [ -f "../../.env" ]; then
			set -a
			source "../../.env"
			set +a
		fi
		docker compose -p "$GF_STACK_NAME" up -d
		cd "$rootScriptDirectory"
	fi
}

run_inference_server() {
	cd "$rootScriptDirectory"
	if [ -f "$GF_INFERENCE_SERVICE_LOCK" ]; then
		cd "../docker/llama_cpp/"
		docker stop "$GF_INFERENCE_SERVICE"
		echo "Inference server locked"
		cd "$rootScriptDirectory"
		log_inference_status "LOCKED"
		return
	fi
	if [ ! -f "$GF_INFERENCE_COMPOSE_FILE_SOURCE" ]; then
		echo "Missing desired inference config"
		log_inference_status "NOT CONFIGURED"
		return
	fi
	local ymlSourceHash=$(md5sum "$GF_INFERENCE_COMPOSE_FILE_SOURCE" | xargs | cut -d " " -f 1)
	local ymlTargetHash='GlacierFlow'
	if [ -f "$GF_INFERENCE_COMPOSE_FILE_TARGET" ]; then
		ymlTargetHash=$(md5sum "$GF_INFERENCE_COMPOSE_FILE_TARGET" | xargs | cut -d " " -f 1)
	fi

	local forceInferenceServerRun=0

	if [[ "$ymlSourceHash" == "$ymlTargetHash" ]]; then
		# chosen setup OK, make sure it IS running
		if [ "$(docker ps | grep "$GF_INFERENCE_SERVICE" | wc -l)" -lt 1 ]; then
			forceInferenceServerRun=1
		else
			# INFERENCE SERVER UP - is it responding?
			local responseCode=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 2 --max-time 5 "$GF_INFERENCE_URL/health")
			local curlExitStatus=$?
			if [ $curlExitStatus -eq 0 ]; then
				if [ "$responseCode" == "503" ]; then
					log_inference_status "LOADING"
				elif [ "$responseCode" == "200" ]; then
					log_inference_status "RUNNING"
				else
					log_inference_status "UMM..."
				fi
			else
				log_inference_status "UMM..."
			fi
		fi
	else
		# HASH CHANGED, OVERWRITE CONFIG
		cat "$GF_INFERENCE_COMPOSE_FILE_SOURCE" >"$GF_INFERENCE_COMPOSE_FILE_TARGET"
		forceInferenceServerRun=1
	fi

	if [ "$forceInferenceServerRun" -eq 1 ]; then
		cd "../docker/llama_cpp/"
		docker stop "$GF_INFERENCE_SERVICE"
		log_inference_status "STOPPED"
		if [ -f "../../.env" ]; then
			set -a
			source "../../.env"
			set +a
		fi
		docker compose pull
		docker compose -p "$GF_STACK_NAME" up -d
		cd "$rootScriptDirectory"
		date +%s >"$GF_INFERENCE_SERVICE_UP_TIMESTAMP"
		echo "$ymlSourceHash" >"$GF_INFERENCE_SERVICE_UP_HASH"
		log_inference_status "LAUNCHING"
		if [ -f "$GF_INFERENCE_PRESET_NAME_DESIRED" ]; then
			cat "$GF_INFERENCE_PRESET_NAME_DESIRED" >"$GF_INFERENCE_PRESET_NAME"
		fi
	fi
	log_inference_statistics
}

# ── Preflight ─────────────────────────────────────────────────────────────────

run_preflight_checks() {
	echo "Preflight check..."
	fail_preflight_on_missing_binary cat
	fail_preflight_on_missing_binary curl
	fail_preflight_on_missing_binary cut
	fail_preflight_on_missing_binary date
	fail_preflight_on_missing_binary docker
	fail_preflight_on_missing_binary grep
	fail_preflight_on_missing_binary md5sum
	fail_preflight_on_missing_binary openssl
	fail_preflight_on_missing_binary pwd
	fail_preflight_on_missing_binary tail
	fail_preflight_on_missing_binary xargs
	echo "Preflight check DONE"
}

# ── Main ──────────────────────────────────────────────────────────────────────

run_main_service() {
	echo "Starting GlacierFlow background service"
	if [[ $isDaemon -eq 0 ]]; then
		echo "[Will execute once and exit]"
	fi
	run_preflight_checks
	run_web_ui
	run_pi_dev
	run_caddy
	run_embedding_server
	run_proxy
	run_hermes
	run_vscode
	while true; do
		run_inference_server

		echo "[HEALTH TICK] $(date)"
		# If not in daemon mode, break immediately after the first iteration
		if [[ $isDaemon -eq 0 ]]; then
			break
		fi
		sleep "$GF_DAEMON_MODE_FREQUENCY"
	done

	echo "GlacierFlow background service stopped"
}

tty_clear
run_main_service

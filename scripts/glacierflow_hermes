#!/bin/bash
rootScriptDirectory=$(pwd)
source "$rootScriptDirectory/gf_common.sh"

# ── Script-specific constants ─────────────────────────────────────────────────

GF_HERMES_SERVICE="glacierflow-hermes"
GF_CONTAINER_START_TIMEOUT=120

# ── hermes helpers ────────────────────────────────────────────────────────────

hermes_attach() {
	docker exec -it "$GF_HERMES_SERVICE" bash /init-data/start
}

hermes_start() {
	echo "Starting hermes..."
	cd "$rootScriptDirectory"
	mkdir -p "../data/hermes"
	cd "../docker/hermes/"
	if [ -f "../../.env" ]; then
		set -a
		source "../../.env"
		set +a
	fi
	docker compose -p "$GF_STACK_NAME" up -d
	local isRunning="0"
	local elapsed=0
	while [[ $isRunning == "0" ]]; do
		if [ "$elapsed" -ge "$GF_CONTAINER_START_TIMEOUT" ]; then
			echo "Error: container failed to start within ${GF_CONTAINER_START_TIMEOUT}s. Aborting."
			cd "$rootScriptDirectory"
			return 1
		fi
		echo "waiting for container... (${elapsed}/${GF_CONTAINER_START_TIMEOUT}s)"
		isRunning=$(is_hermes_running)
		sleep 1
		elapsed=$((elapsed + 1))
	done
	cd "$rootScriptDirectory"
}

hermes_stop() {
	echo "Stopping hermes..."
	docker stop "$GF_HERMES_SERVICE"
}

is_hermes_running() {
	if [ "$(docker ps --filter status=running | grep "$GF_HERMES_SERVICE" | wc -l)" -lt 1 ]; then
		echo "0"
	else
		echo "1"
	fi
}

# ── Main ──────────────────────────────────────────────────────────────────────

run_main() {
	local actionToRun
	while true; do
		tty_clear
		echo ""
		echo "hermes in a box!"
		echo ""
		echo "Select action:"
		echo ""
		if [ "$(is_hermes_running)" -eq 1 ]; then
			echo "[A] attach to hermes"
			echo "[D] stop hermes container"
		else
			echo "[U] start hermes container"
		fi
		echo ""
		echo "[X] exit"
		echo ""
		read -p "Selected action: " actionToRun
		case "$actionToRun" in
		x | X)
			echo "👋 Bye!"
			exit 0
			break
			;;
		u | U)
			tty_clear
			hermes_start
			;;
		a | A)
			tty_clear
			hermes_attach
			;;
		d | D)
			tty_clear
			hermes_stop
			;;
		*)
			echo ""
			;;
		esac
	done
}

run_main

#!/bin/bash

source "$(dirname "$0")/gf_common.sh"
BENCHMARK_PASSES=3

# ── Benchmark helpers ─────────────────────────────────────────────────────────

list_current_results() {
	local currentModel=$1
	local presetFiles=$(find "$GF_INFERENCE_PRESETS_DIR_LOCAL" -name '*.yml' | sort -f)
	if [ -z "$presetFiles" ]; then
		echo "Listing example presets (no local presets found)"
		presetFiles=$(find "$GF_INFERENCE_PRESETS_DIR_EXAMPLE" -name '*.yml' | sort -f)
	fi

	local presetName=""
	local presetNameLength=1
	local prefix=" "
	local partialLine=""
	for presetFile in $presetFiles; do
		presetName=$(basename "$presetFile" ".yml")
		if [ "${#presetName}" -gt $presetNameLength ]; then
			presetNameLength=$(echo "${#presetName}")
		fi
	done
	presetNameLength=$(($presetNameLength + 1))

	local lastBenchName=""
	local benchmarkName=""
	local lastResult=""
	local benchmarkResultFiles=$(find "$GF_BENCHMARK_PRESETS_DIR" -name '*.txt' | sort -f)

	# HEADER
	local printLine="  "
	partialLine=$(add_minimal_padding " " $presetNameLength)
	echo -n "$printLine$partialLine"

	for benchmarkResultFile in $benchmarkResultFiles; do
		benchmarkName=$(basename "$benchmarkResultFile" ".txt")
		lastBenchName=$benchmarkName
		echo -n "$(add_minimal_padding "$benchmarkName" 7 left)"
	done
	echo " "

	# DATA
	for presetFile in $presetFiles; do
		presetName=$(basename "$presetFile" ".yml")
		presetName=$(add_minimal_padding "$presetName" $presetNameLength)
		presetHash=$(md5sum "$presetFile" | cut -d " " -f 1)
		prefix="   "
		if [[ "$presetHash" == "$currentModel" ]]; then
			prefix="-> "
		fi

		echo -n "$prefix$presetName"

		for benchmarkResultFile in $benchmarkResultFiles; do
			benchmarkName=$(basename "$benchmarkResultFile" ".txt")
			lastResult=$(benchmark_result_read "$presetHash" "$benchmarkName")

			if [[ "$benchmarkName" == "$lastBenchName" ]]; then
				echo "$(add_minimal_padding "$lastResult" 7 left)"
			else
				echo -n "$(add_minimal_padding "$lastResult" 7 left)"
			fi
		done
	done

	echo ""
	echo "run with parameter 'run' to benchmark current model"
}

run_benchmarks_for_model() {
	echo ""
	echo "Benchmarking preset $1"
	echo ""
	local benchmarkFiles=$(find "$GF_BENCHMARK_PRESETS_DIR" -name '*.json' | sort -f)
	for benchmarkFile in $benchmarkFiles; do
		run_benchmark_for_model "$1" "$benchmarkFile"
	done
}

benchmark_result_read() {
	local modelHash=$1
	local benchmarkName=$2
	local benchmarkResultFile="$GF_BENCHMARK_PRESETS_DIR$benchmarkName.txt"

	if [ ! -f "$benchmarkResultFile" ]; then
		echo "0"
		return 0
	fi

	local hasResultLine=$(cat "$benchmarkResultFile" | grep "$modelHash" | wc -l)
	if [ "$hasResultLine" -eq 1 ]; then
		cat "$benchmarkResultFile" | grep "$modelHash" | cut -d " " -f 2
	else
		echo "0"
	fi
}

benchmark_result_save() {
	local modelHash=$1
	local benchmarkName=$2
	local currentResult=$3
	local benchmarkResultFile="$GF_BENCHMARK_PRESETS_DIR$benchmarkName.txt"

	if grep -q "^${modelHash} " "$benchmarkResultFile" 2>/dev/null; then
		sed -i "s/^${modelHash} .*/${modelHash} ${currentResult}/" "$benchmarkResultFile"
	else
		echo "${modelHash} ${currentResult}" >>"$benchmarkResultFile"
	fi
}

run_benchmark_for_model() {
	local modelHash=$1
	local benchmarkFile=$2
	local benchmarkName=$(basename "$benchmarkFile" '.json')
	local previousResult=$(benchmark_result_read "$modelHash" "$benchmarkName")

	if [[ "$previousResult" != "0" ]]; then
		echo "Benchmark $benchmarkName was ran previously, result: $previousResult TPS"
		return 0
	fi

	echo "Starting benchmark $benchmarkName..."

	local sum=0
	local hasErrors=0
	local timeTaken=0
	local predictionTps=0
	for i in $(seq 1 "$BENCHMARK_PASSES"); do
		echo "Pass $i/$BENCHMARK_PASSES started at $(date +%H:%M:%S)"
		if [ "$timeTaken" -gt 0 ]; then
			start_epoch=$(date +%s)
			finish_epoch=$((start_epoch + timeTaken))
			estimatedFinish=$(date -d "@$finish_epoch" +%H:%M:%S 2>/dev/null)
			echo "Estimated pass finish: $estimatedFinish"
		fi
		if ! jsonResponse=$(
			curl "$GF_INFERENCE_URL/v1/chat/completions" \
				-H "Content-Type: application/json" \
				-d @"$benchmarkFile" -s -f
		); then
			echo "ERROR OCCURRED ON INFERENCE SERVER"
			hasErrors=1
		elif ! echo "$jsonResponse" | jq -e '.timings.predicted_per_second and .timings.predicted_n and .timings.predicted_ms' >/dev/null 2>&1; then
			echo "ERROR: UNEXPECTED RESPONSE FROM INFERENCE SERVER"
			hasErrors=1
		else
			predictionTps=$(echo "$jsonResponse" | jq '.timings.predicted_per_second' | xargs)
			predictedTokens=$(echo "$jsonResponse" | jq '.timings.predicted_n' | xargs)
			timeTaken=$(echo "$jsonResponse" | jq '.timings.predicted_ms' | xargs)
			timeTaken=$(echo "$timeTaken / 1000" | bc -l)
			timeTaken=$(echo "$timeTaken" | cut -d "." -f 1)
			echo " --> pass $i/$BENCHMARK_PASSES TPS: $predictionTps ($predictedTokens tokens in $timeTaken seconds)"
			sum=$(echo "$sum + $predictionTps" | bc -l)
		fi
	done
	if [ "$hasErrors" -eq 0 ]; then
		local mean=$(echo "$sum/$BENCHMARK_PASSES" | bc -l)
		local numBeforeDot=$(echo "$mean" | cut -d "." -f 1)
		local numAfterDot=$(echo "$mean" | cut -d "." -f 2)
		numAfterDot=${numAfterDot:0:2}
		mean="$numBeforeDot.$numAfterDot"
		echo " -------> average TPS: $mean"
		echo ""
		benchmark_result_save "$modelHash" "$benchmarkName" "$mean"
	fi
}

# ── Preflight ─────────────────────────────────────────────────────────────────

run_preflight_checks() {
	fail_preflight_on_missing_binary basename
	fail_preflight_on_missing_binary bc
	fail_preflight_on_missing_binary cat
	fail_preflight_on_missing_binary curl
	fail_preflight_on_missing_binary date
	fail_preflight_on_missing_binary find
	fail_preflight_on_missing_binary grep
	fail_preflight_on_missing_binary jq
	fail_preflight_on_missing_binary md5sum
	fail_preflight_on_missing_binary sed
	fail_preflight_on_missing_binary seq
}

# ── Main ──────────────────────────────────────────────────────────────────────

run_main() {
	run_preflight_checks
	local currentModelHash=$(cat "$GF_INFERENCE_SERVICE_UP_HASH")
	local inferenceServerStatus=$(cat "$GF_INFERENCE_SERVICE_UP_STATUS")

	if [ -z "$1" ]; then
		list_current_results "$currentModelHash"
	elif [ "$1" != "run" ]; then
		echo "Unknown command: $1"
		echo "Usage: $0 [run [passes]]"
		exit 1
	else
		if [[ "$inferenceServerStatus" != "RUNNING" ]]; then
			echo "Inference not running"
			exit 1
		fi
		if [ -z "$2" ]; then
			local passesAmount=3
			read -p "How many passes on each benchmark? [3]: " passesAmount
			if [[ -z "$passesAmount" ]]; then
				BENCHMARK_PASSES=3
			elif ! [[ "$passesAmount" =~ ^[1-9][0-9]*$ ]]; then
				echo "Error: value must be a positive integer"
				exit 1
			else
				BENCHMARK_PASSES=$passesAmount
			fi
		elif ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
			echo "Error: value must be a positive integer"
			exit 1
		else
			BENCHMARK_PASSES=$2
		fi
		run_benchmarks_for_model "$currentModelHash"
	fi
}

tty_clear
run_main "$1" "$2"
